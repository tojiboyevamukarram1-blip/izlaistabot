# ==========================================================
# Private Telegram Media Downloader Bot Configuration (.env)
# ==========================================================

# 1. Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Telegram Numeric User ID of the Bot Owner (Required for Private Mode)
# Only this Telegram user ID can interact with the bot; all other users are rejected.
# To find your ID: send any message to @userinfobot or @chatIDrobot in Telegram.
OWNER_ID=123456789

# ==========================================================
# Optional Performance and Resource Limits
# ==========================================================

# Redis Connection URL (Optional: falls back to built-in in-memory cache if unreachable)
REDIS_URL=redis://localhost:6379/0

# Maximum file download limit in Megabytes (Telegram standard bot limit is 50MB)
MAX_FILE_SIZE_MB=50

# Maximum media duration in seconds (1800 = 30 minutes)
MAX_DURATION_SECONDS=1800

# Concurrency and Single-User Settings
MAX_CONCURRENT_DOWNLOADS=3
REQUEST_TIMEOUT=60

# Path to FFmpeg executable (default: ffmpeg from system PATH)
FFMPEG_PATH=ffmpeg

# Temporary media folder path
TEMP_DIR=temp_media

# Optional: Path to Netscape cookies.txt file for user-authorized Instagram or YouTube requests
# COOKIES_FILE=cookies.txt
